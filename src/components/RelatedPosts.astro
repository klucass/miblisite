---
import PostCard from "./PostCard.astro";
import { getRelatedPosts } from "../lib/tags";

interface Props {
  /** id do post atual, para excluí-lo da lista. */
  slug: string;
  limit?: number;
}

const { slug, limit = 3 } = Astro.props;
const related = await getRelatedPosts(slug, limit);
---

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Leia também</h2>
      <div class="related-grid">
        {related.map((post) => (
          <PostCard post={post} compact={true} />
        ))}
      </div>
    </section>
  )
}

<style>
  /* Já vive dentro do <main>, que aplica a largura máxima e o padding lateral */
  .related {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 2px solid #1a1a1a;
  }

  .related h2 {
    font-family: "cabinet", ui-sans-serif, system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 2rem;
    letter-spacing: -0.3px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
