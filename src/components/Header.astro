---
import { Image } from "astro:assets";
import logo from "../assets/miblify_logo.png";

interface Props {
  isBlog?: boolean;
}

const { isBlog = false } = Astro.props;
---

<header id="main-header" class="sticky top-0 z-50 transition-all duration-300">
  <div class="flex justify-between items-center max-w-7xl mx-auto px-6 py-4">
    <a
      href={isBlog ? "/blog/" : "/"}
      class="outline-none focus:outline-none active:outline-none"
      style="-webkit-tap-highlight-color: transparent;">
      <Image src={logo} alt="Miblify" class="w-32 border-none ring-0 outline-none" />
    </a>

    <div class="flex items-center gap-6 md:gap-8">
      {
        isBlog && (
          <a href="/" class="text-[#1A1A1A] font-medium hover:text-[#3B38E8] transition-colors hidden sm:block">
            Home do site
          </a>
        )
      }
      {
        !isBlog && (
          <span class="header-cta-enter inline-block">
            <a
              href="https://app.miblify.com"
              class="bg-amarelo border-2 border-[#1A1A1A] text-[#1A1A1A] px-6 py-2 rounded-xl font-bold transition-all hover:-translate-y-0.5 active:translate-y-0 header-cta">
              Entrar
            </a>
          </span>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Header sticky com fundo semi-transparente */
  #main-header {
    background-color: transparent;
  }

  #main-header.scrolled {
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Entra junto com o resto da página em vez de aparecer pronto antes de tudo.
     A animação fica no wrapper para não competir com o translate de hover do botão. */
  @keyframes header-cta-enter {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .header-cta-enter {
    animation: header-cta-enter 0.5s cubic-bezier(0.4, 0, 0.2, 1) 0.35s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .header-cta-enter {
      animation: none;
    }
  }

  .header-cta {
    box-shadow: 3px 3px 0 0 #1a1a1a;
  }
  .header-cta:hover {
    box-shadow: 4px 4px 0 0 #1a1a1a;
  }
  .header-cta:active {
    box-shadow: 1px 1px 0 0 #1a1a1a;
  }
</style>

<script>
  // Header sticky com scroll
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("main-header");

    // Check if we are already scrolled on load
    if (window.pageYOffset > 50) {
      header?.classList.add("scrolled");
    }

    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }
    });
  });
</script>
