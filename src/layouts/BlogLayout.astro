---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogCTA from "../components/BlogCTA.astro";
import { Image } from "astro:assets";
import Calendar from "phosphor-astro/CalendarDuotone.astro";
import TagList from "../components/TagList.astro";
import RelatedPosts from "../components/RelatedPosts.astro";

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  heroImage?: any;
  tags?: string[];
  /** id do post, usado para montar o bloco de artigos relacionados. */
  slug?: string;
}

const { title, description, pubDate, heroImage, tags = [], slug } = Astro.props;

// Normaliza a URL da imagem para o Layout (Open Graph)
const ogImage = heroImage
  ? typeof heroImage === "string"
    ? heroImage.startsWith("http")
      ? heroImage
      : new URL(heroImage, Astro.site || "https://www.miblify.com").toString()
    : new URL(heroImage.src, Astro.site || "https://www.miblify.com").toString()
  : undefined;
---

<Layout title={`${title} | Blog Miblify`} description={description} image={ogImage}>
  <div class="flex flex-col min-h-screen">
    <Header isBlog={true} />
    <main class="max-w-4xl mx-auto px-6 pt-20 md:py-12 grow w-full">
      <article class="prose prose-lg prose-slate max-w-none">
        {
          heroImage &&
            (typeof heroImage === "string" ? (
              <img src={heroImage} alt="" class="w-full h-auto rounded-sm mb-6 shadow-sm border-2 border-[#1A1A1A]" />
            ) : (
              <Image src={heroImage} alt="" class="w-full h-auto rounded-sm mb-6 shadow-sm border-2 border-[#1A1A1A]" />
            ))
        }
        <div class="md:py-6">
          <h1 class="text-4xl md:text-6xl font-bold text-[#3B38E8] mb-8 font-cabinet-bold leading-tight tracking-tight">
            {title}
          </h1>
          {
            pubDate && (
              <div class="blog-meta">
                <Calendar weight="duotone" class="blog-meta-icon size-8" />
                <time dateTime={pubDate.toISOString()}>
                  {pubDate.toLocaleDateString("pt-BR", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>
            )
          }
          {tags.length > 0 && <TagList tags={tags} variant="solid" class="post-tags" />}
        </div>
        <div class="blog-content">
          <slot />
        </div>
      </article>
      {slug && <RelatedPosts slug={slug} limit={3} />}
    </main>
    <BlogCTA />
    <Footer />
  </div>
</Layout>

<style is:global>
  .blog-content {
    color: #333;
    line-height: 1.8;
    font-size: 1.25rem;
  }

  /* Data de publicação — discreta e elegante */
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }

  .blog-meta-icon {
    color: #999;
    flex-shrink: 0;
  }

  .blog-meta time {
    font-family: "cabinet", sans-serif;
    color: #666;
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: capitalize;
    letter-spacing: 0.3px;
    transition: color 0.3s ease;
  }

  .blog-meta time:hover {
    color: #3b38e8;
  }

  /* Quando há tags logo abaixo, a data respira menos para os dois virarem um bloco */
  .blog-meta:has(+ .post-tags) {
    margin-bottom: 1rem;
  }

  /* Seleção de texto — divertida com cores da marca */
  .blog-content ::selection {
    background: oklch(77.74% 0.2001 333.22);
    color: white;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .blog-content a {
    color: #3b38e8;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .blog-content a:hover {
    color: #1a1a1a;
    text-decoration-thickness: 2px;
  }

  /* H2 — Roxo (Primary), grande e impactante */
  .blog-content h2 {
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: #3b38e8;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  /* H3 — Rosa (Secondary), substítulo elegante */
  .blog-content h3 {
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: #333;
    margin-top: 3rem;
    margin-bottom: 1.2rem;
    font-size: 1.875rem;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  /* H4 — Amarelo (Accent), destaque sutil */
  .blog-content h4 {
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: #1a1a1a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;

    display: inline-block;
    padding: 0.5rem 1rem;
  }

  .blog-content p {
    margin-bottom: 1.5rem;
  }

  .blog-content ul,
  .blog-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content ul {
    list-style-type: none;
  }

  .blog-content ol {
    list-style: decimal;
    padding-left: 2.5rem;
  }

  .blog-content li {
    margin-bottom: 0.75rem;
    position: relative;
  }

  /* Marcador customizado para listas não ordenadas */
  .blog-content ul > li {
    padding-left: 1.5rem;
  }

  .blog-content ul > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #3b38e8;
  }

  .blog-content ol > li {
    padding-left: 0.25rem;
  }

  .blog-content ol > li::marker {
    color: #3b38e8;
    font-weight: 700;
  }

  /* Separador de seção */
  .blog-content hr {
    border: none;
    border-top: 2px solid #1a1a1a;
    margin: 3.5rem 0;
    opacity: 0.15;
  }

  /* Código inline */
  .blog-content code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    background: #f2f2f7;
    border: 1px solid #e0e0ea;
    border-radius: 3px;
    padding: 0.15em 0.4em;
    white-space: nowrap;
  }

  .blog-content a code {
    color: inherit;
  }

  /* Citação */
  .blog-content blockquote {
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 4px solid #3b38e8;
    color: #555;
    font-style: italic;
  }

  .blog-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Tabelas — mesmo visual de borda dura do resto do site */
  .blog-content table {
    width: 100%;
    margin: 2.5rem 0;
    border-collapse: collapse;
    border: 2px solid #1a1a1a;
    border-radius: 2px;
    font-size: 1.05rem;
    line-height: 1.5;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .blog-content thead {
    background: #3b38e8;
  }

  .blog-content th {
    padding: 0.9rem 1.1rem;
    text-align: left;
    font-family: "cabinet", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.2px;
    border-right: 2px solid #1a1a1a;
  }

  .blog-content td {
    padding: 0.85rem 1.1rem;
    border-top: 2px solid #1a1a1a;
    border-right: 2px solid #1a1a1a;
    vertical-align: top;
  }

  .blog-content th:last-child,
  .blog-content td:last-child {
    border-right: none;
  }

  .blog-content tbody tr:nth-child(even) {
    background: #f7f7fb;
  }

  /* Última linha de tabela de conta costuma ser o total */
  .blog-content tbody tr:last-child td strong {
    color: #3b38e8;
  }

  /* Colunas numéricas alinhadas à direita quando a tabela tem 2 colunas */
  .blog-content th:not(:first-child),
  .blog-content td:not(:first-child) {
    text-align: right;
    white-space: nowrap;
  }

  /* Em telas estreitas a tabela rola horizontalmente em vez de vazar */
  @media (max-width: 640px) {
    .blog-content table {
      display: block;
      overflow-x: auto;
      font-size: 0.95rem;
    }

    .blog-content th,
    .blog-content td {
      padding: 0.7rem 0.85rem;
    }
  }
</style>
