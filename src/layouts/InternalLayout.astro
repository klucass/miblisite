---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title ? `${title} | Miblify` : "Miblify - Venda seu produto digital"} description={description}>
  <Header />
  <main class="min-h-screen py-10 px-6">
    <div class="max-w-4xl mx-auto p-8 md:p-14">
      <article
        class="prose prose-lg max-w-none prose-headings:font-cabinet-bold prose-p:text-base-content/80 prose-headings:text-base-content text-lg">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Basic typography for internal pages - standard CSS to avoid @apply errors */
  article h1 {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    article h1 {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
  }

  article h2 {
    font-size: 1.1rem;
    line-height: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    article h2 {
      font-size: 1.25rem;
      line-height: 2.25rem;
    }
  }

  article h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    article h3 {
      font-size: 1.5rem;
      line-height: 2rem;
    }
  }

  article p {
    margin-bottom: 1rem;
    line-height: 1.625;
  }

  /* Links dentro do texto: sublinhado grosso na cor da marca, para ficarem
     visíveis em parágrafos longos de termos e política sem virar outra cor. */
  article a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--color-primary) 35%, transparent);
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease,
      background-color 0.15s ease;
  }

  article a:hover {
    color: var(--color-base-content);
    text-decoration-color: var(--color-amarelo);
    background-color: var(--color-amarelo);
    border-radius: 0.25rem;
    box-shadow:
      0 0 0 2px var(--color-amarelo),
      0 0 0 3px var(--color-base-content);
  }

  article a:focus-visible {
    outline: 2px solid var(--color-base-content);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  article ul {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 1rem;
    margin-left: 1rem;
  }

  article li {
    margin-bottom: 0.5rem;
  }
</style>
