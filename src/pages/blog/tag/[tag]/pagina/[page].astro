---
import Layout from "../../../../../layouts/Layout.astro";
import Header from "../../../../../components/Header.astro";
import Footer from "../../../../../components/Footer.astro";
import BlogCTA from "../../../../../components/BlogCTA.astro";
import PostCard from "../../../../../components/PostCard.astro";
import Pagination from "../../../../../components/Pagination.astro";
import { getAllTags, getPostsByTagSlug, paginate, tagPageUrl, POSTS_PER_PAGE } from "../../../../../lib/tags";

export async function getStaticPaths() {
  const tags = await getAllTags();
  const paths = [];

  for (const tag of tags) {
    const lastPage = Math.max(1, Math.ceil(tag.count / POSTS_PER_PAGE));
    // Página 1 mora em /blog/tag/<slug>/, então começamos da 2.
    for (let page = 2; page <= lastPage; page++) {
      paths.push({ params: { tag: tag.slug, page: String(page) }, props: { label: tag.tag, count: tag.count } });
    }
  }

  return paths;
}

const { label, count } = Astro.props;
const tagSlug = Astro.params.tag!;
const posts = await getPostsByTagSlug(tagSlug);
const page = paginate(posts, Number(Astro.params.page));
---

<Layout
  title={`${label} | Página ${page.currentPage} | Blog Miblify`}
  description={`Artigos sobre ${label}. Página ${page.currentPage} de ${page.lastPage}.`}>
  <div class="flex flex-col min-h-screen">
    <Header isBlog={true} />
    <main class="max-w-6xl mx-auto px-6 py-20 md:py-32 grow w-full">
      <header class="mb-12 md:mb-16 text-center">
        <p class="mb-4">
          <a href={tagPageUrl(tagSlug)} class="back-link">← {label}</a>
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-[#1A1A1A] mb-6 font-cabinet-bold">{label}</h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Página {page.currentPage} de {page.lastPage}, num total de {count} artigos.
        </p>
      </header>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {page.items.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlFor={(p) => tagPageUrl(tagSlug, p)} />
    </main>
    <BlogCTA />
    <Footer />
  </div>
</Layout>

<style>
  .back-link {
    font-family: "cabinet", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #3b38e8;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .back-link:hover {
    color: #1a1a1a;
  }
</style>
