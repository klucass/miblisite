---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCTA from "../../components/BlogCTA.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getSortedPosts, getAllTags, paginate, blogPageUrl, tagPageUrl } from "../../lib/tags";

const posts = await getSortedPosts();
const tags = await getAllTags();
const page = paginate(posts, 1);
---

<Layout title="Blog | Miblify" description="Artigos sobre vendas digitais, marketing e novidades da Miblify.">
  <div class="flex flex-col min-h-screen">
    <Header isBlog={true} />
    <main class="max-w-6xl mx-auto px-6 py-20 md:py-32 grow w-full">
      <header class="mb-12 md:mb-16 text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-[#1A1A1A] mb-6 font-cabinet-bold">Blog Miblify</h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Conteúdo especializado para quem quer escalar suas vendas de produtos digitais com simplicidade.
        </p>
      </header>

      {
        tags.length > 0 && (
          <nav class="tag-cloud" aria-label="Assuntos do blog">
            {tags.map((tag) => (
              <a href={tagPageUrl(tag.slug)}>
                {tag.tag}
                <span class="tag-cloud-count">{tag.count}</span>
              </a>
            ))}
          </nav>
        )
      }

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {page.items.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} urlFor={blogPageUrl} />

      {
        posts.length === 0 && (
          <div class="text-center py-20 bg-gray-50 rounded-3xl">
            <p class="text-gray-500 text-lg">Em breve teremos nossos primeiros artigos por aqui!</p>
          </div>
        )
      }
    </main>
    <BlogCTA />
    <Footer />
  </div>
</Layout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: "cabinet", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: lowercase;
    color: #1a1a1a;
    background: #fff;
    padding: 0.5rem 0.85rem;
    border: 2px solid #1a1a1a;
    border-radius: 2px;
    box-shadow: 2px 2px 0 0 #1a1a1a;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .tag-cloud a:hover {
    background: #3b38e8;
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 0 #1a1a1a;
  }

  .tag-cloud a:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 0 #1a1a1a;
  }

  .tag-cloud-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
  }
</style>
